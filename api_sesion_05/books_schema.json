{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "description": "ID sách" },
    "name": { "type": "string" },
    "price": { "type": "number", "minimum": 0 },
